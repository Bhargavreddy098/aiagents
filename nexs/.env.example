# ════════════════════════════════ core ════════════════════════════════
DATABASE_URL=postgresql://nexs:nexs@localhost:5432/nexs?schema=public
PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info
TZ=UTC

# ═══════════════════════════ crypto & auth ════════════════════════════
# The only secret. It signs access tokens and, via HKDF, derives the vault key that encrypts
# stored provider keys, connector tokens and MCP environment blocks.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it makes existing credentials undecryptable — they must be re-entered.
JWT_SECRET=<min 32 chars, random>
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# ═══════════════════════ worker, jobs & scheduling ═════════════════════
WORKER_ENABLED=true
PGBOSS_SCHEMA=nexs_jobs
TENANT_CONCURRENCY=5
WORKER_CONCURRENCY=2
CRON_TIMEZONE=UTC

# ═══════════════════════════ storage & limits ══════════════════════════
STORAGE_ROOT=./data/storage
MAX_UPLOAD_MB=25
TOOL_RESULT_MAX_KB=64
RUN_STALE_AFTER_MS=900000
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_DEFAULT_PER_MIN=120

# ════════════════════════════════ sse ═════════════════════════════════
SSE_HEARTBEAT_MS=15000
SSE_MAX_CONNECTIONS_PER_IP=10

# ══════════════════════════════ feature flags ══════════════════════════
FEATURE_MCP=true
FEATURE_CONNECTORS=true
FEATURE_SANDBOX=true
FEATURE_BROWSER=true
FEATURE_RESEARCH=true

# ══════════════════════════════ response cache ═════════════════════════
CACHE_DRIVER=postgres
CACHE_TTL_SEC=86400

# ════════════════════════════════ tests (CI) ═══════════════════════════
DATABASE_URL_TEST=postgresql://nexs:nexs@localhost:5433/nexs_test?schema=public
